{
  "name": "fetch",
  "displayName": "Fetch",
  "version": "0.1.9",
  "description": "Fetch",
  "author": "Alphahub",
  "scripts": {
    "start": "next start",
    "dev": "run-p dev:*",
    "dev:plasmo": "plasmo dev",
    "dev:next": "next dev --port 1947",
    "build": "run-p build:*",
    "build:plasmo": "plasmo build",
    "build:next": "next build"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.6.2",
    "@rainbow-me/rainbowkit": "^2.2.1",
    "@reown/appkit": "^1.7.0",
    "@reown/appkit-adapter-wagmi": "^1.7.0",
    "@tanstack/react-query": "^5.62.8",
    "connectkit": "^1.8.2",
    "fuse.js": "^7.0.0",
    "is-url": "^1.2.4",
    "luxon": "^3.5.0",
    "next": "14.1.0",
    "plasmo": "0.90.3",
    "react": "18.2.0",
    "react-colorful": "^5.6.1",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "18.2.0",
    "react-fast-compare": "^3.2.2",
    "react-icons": "^5.2.1",
    "slate": "^0.103.0",
    "slate-react": "^0.110.0",
    "uuid": "^11.1.0",
    "viem": "~2.21.55",
    "wagmi": "^2.14.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@plasmohq/rps": "1.8.7",
    "@plasmohq/storage": "1.11.0",
    "@types/chrome": "0.0.258",
    "@types/luxon": "^3.4.2",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.19",
    "crypto-browserify": "^3.12.0",
    "postcss": "^8.4.39",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.6",
    "typescript": "5.3.3"
  },
  "manifest": {
    "web_accessible_resources": [
      {
        "resources": [
          "~assets/*.png",
          "assets/*.png",
          "~public/*.png",
          "tabs/*"
        ],
        "matches": [
          "http://localhost:3000/*"
        ]
      }
    ],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "permissions": [
      "tabs",
      "storage",
      "activeTab"
    ]
  }
}
